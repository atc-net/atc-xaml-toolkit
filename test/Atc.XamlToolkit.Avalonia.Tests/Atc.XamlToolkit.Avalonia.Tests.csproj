<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atc.XamlToolkit.Avalonia\Atc.XamlToolkit.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Atc.XUnit" Version="4.0.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
  </ItemGroup>

  <!--
    The headless session sets up an isolated application for every dispatch, which rebinds
    Avalonia's UI-thread dispatcher. A test on another thread that touches Avalonia in that
    moment makes its own thread the UI thread, and the dispatch then fails with "the calling
    thread cannot access this object". xunit.runner.json therefore turns parallel test
    collections off for this project.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>