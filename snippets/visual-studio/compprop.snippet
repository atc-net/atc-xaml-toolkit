<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>compprop</Title>
      <Shortcut>compprop</Shortcut>
      <Description>Atc.XamlToolkit: ComputedProperty with auto-detected dependencies.</Description>
      <Author>Atc.XamlToolkit</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>type</ID>
          <ToolTip>Property type</ToolTip>
          <Default>string</Default>
        </Literal>
        <Literal>
          <ID>name</ID>
          <ToolTip>Property name</ToolTip>
          <Default>FullName</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[[ComputedProperty]
public $type$ $name$ => $end$;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>