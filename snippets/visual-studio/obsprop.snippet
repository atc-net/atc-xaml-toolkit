<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>obsprop</Title>
      <Shortcut>obsprop</Shortcut>
      <Description>Atc.XamlToolkit: source-generated INotifyPropertyChanged property from a private field.</Description>
      <Author>Atc.XamlToolkit</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>type</ID>
          <ToolTip>Backing-field type</ToolTip>
          <Default>string</Default>
        </Literal>
        <Literal>
          <ID>name</ID>
          <ToolTip>camelCase backing-field name</ToolTip>
          <Default>fieldName</Default>
        </Literal>
        <Literal>
          <ID>init</ID>
          <ToolTip>Initial value</ToolTip>
          <Default>string.Empty</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[[ObservableProperty]
private $type$ $name$ = $init$;$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>