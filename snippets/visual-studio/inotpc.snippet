<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>inotpc</Title>
      <Shortcut>inotpc</Shortcut>
      <Description>Atc.XamlToolkit: add INotifyPropertyChanged to a partial class without inheriting ObservableObject.</Description>
      <Author>Atc.XamlToolkit</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>Class name</ToolTip>
          <Default>MyClass</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[[INotifyPropertyChanged]
public partial class $name$
{
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>