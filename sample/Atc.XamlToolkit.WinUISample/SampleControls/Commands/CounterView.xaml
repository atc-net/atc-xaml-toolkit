<UserControl
    x:Class="Atc.XamlToolkit.WinUISample.SampleControls.Commands.CounterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <Grid Margin="10" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="Sync RelayCommand + CanExecute" />
            <TextBlock
                Opacity="0.7"
                Text="Decrement and Reset are gated on the counter value via CanExecute = nameof(...). [NotifyCanExecuteChangedFor] on the counter raises CanExecuteChanged automatically. The parameterized AddValue command is bound with CommandParameter."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Counter readout  -->
        <Border
            Grid.Row="1"
            Padding="10"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="Counter:" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="{x:Bind ViewModel.Counter, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!--  Parameterless commands  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                MinWidth="120"
                Padding="10,5"
                Command="{x:Bind ViewModel.IncrementCommand}"
                Content="Increment" />
            <Button
                MinWidth="120"
                Padding="10,5"
                Command="{x:Bind ViewModel.DecrementCommand}"
                Content="Decrement" />
            <Button
                MinWidth="120"
                Padding="10,5"
                Command="{x:Bind ViewModel.ResetCommand}"
                Content="Reset" />
        </StackPanel>

        <!--  Parameterized commands  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="AddValue parameterized:" />
            <Button
                MinWidth="60"
                Padding="10,5"
                Command="{x:Bind ViewModel.AddValueCommand}"
                CommandParameter="5"
                Content="+5" />
            <Button
                MinWidth="60"
                Padding="10,5"
                Command="{x:Bind ViewModel.AddValueCommand}"
                CommandParameter="10"
                Content="+10" />
            <Button
                MinWidth="60"
                Padding="10,5"
                Command="{x:Bind ViewModel.AddValueCommand}"
                CommandParameter="-3"
                Content="-3" />
            <Button
                MinWidth="60"
                Padding="10,5"
                Command="{x:Bind ViewModel.AddValueCommand}"
                CommandParameter="0"
                Content="0"
                ToolTipService.ToolTip="Disabled — CanAddValue returns false for 0" />
        </StackPanel>
    </Grid>
</UserControl>