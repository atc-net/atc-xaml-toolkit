<UserControl
    x:Class="Atc.XamlToolkit.WpfSample.SampleControls.Messaging.MessengerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messaging="clr-namespace:Atc.XamlToolkit.WpfSample.SampleControls.Messaging"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <messaging:MessengerViewModel />
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="Messenger demo" />
            <TextBlock
                Margin="0,4,0,0"
                Opacity="0.7"
                Text="One sender. Two receivers (delegate-based + IRecipient&lt;T&gt;). Sending hits both because they share Messenger.Default."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Sender  -->
        <Border
            Grid.Row="2"
            Padding="10"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="1"
            CornerRadius="3"
            DataContext="{Binding Sender}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Sender" />
                <TextBox
                    Grid.Column="1"
                    Padding="4"
                    Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Grid.Column="3"
                    Padding="4"
                    Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="5"
                    Padding="10,5"
                    Command="{Binding SendCommand}"
                    Content="Send" />

                <TextBlock
                    Grid.Column="6"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7">
                    <Run Text="Sent: " />
                    <Run FontWeight="Bold" Text="{Binding MessagesSent, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!--  Two receivers side-by-side  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Delegate receiver  -->
            <Border
                Grid.Column="0"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="3"
                DataContext="{Binding DelegateReceiver}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontWeight="SemiBold"
                        Text="Delegate receiver" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,8"
                        FontFamily="Consolas"
                        Opacity="0.7"
                        Text="Messenger.Default.Register&lt;ChatMessage&gt;(this, OnChatMessage)"
                        TextWrapping="Wrap" />

                    <ListBox
                        Grid.Row="2"
                        Padding="4"
                        ItemsSource="{Binding Log}" />

                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Opacity="0.7">
                            <Run Text="Received: " />
                            <Run FontWeight="Bold" Text="{Binding MessagesReceived, Mode=OneWay}" />
                        </TextBlock>
                        <Button
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearCommand}"
                            Content="Clear" />
                    </DockPanel>
                </Grid>
            </Border>

            <!--  Typed (IRecipient<T>) receiver  -->
            <Border
                Grid.Column="2"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="3"
                DataContext="{Binding TypedReceiver}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontWeight="SemiBold"
                        Text="Typed receiver (IRecipient&lt;T&gt;)" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,8"
                        FontFamily="Consolas"
                        Opacity="0.7"
                        Text="class : IRecipient&lt;ChatMessage&gt; { void Receive(...) {...} }"
                        TextWrapping="Wrap" />

                    <ListBox
                        Grid.Row="2"
                        Padding="4"
                        ItemsSource="{Binding Log}" />

                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Opacity="0.7">
                            <Run Text="Received: " />
                            <Run FontWeight="Bold" Text="{Binding MessagesReceived, Mode=OneWay}" />
                        </TextBlock>
                        <Button
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearCommand}"
                            Content="Clear" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>