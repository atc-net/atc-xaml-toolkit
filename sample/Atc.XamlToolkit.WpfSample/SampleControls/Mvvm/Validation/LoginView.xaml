<UserControl
    x:Class="Atc.XamlToolkit.WpfSample.SampleControls.Mvvm.Validation.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:validation="clr-namespace:Atc.XamlToolkit.WpfSample.SampleControls.Mvvm.Validation"
    d:DesignHeight="500"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <validation:LoginViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <DataTemplate x:Key="ValidationErrorTemplate" DataType="ValidationResult">
            <TextBlock
                Foreground="Red"
                Text="{Binding ErrorContent}"
                TextWrapping="Wrap" />
        </DataTemplate>

        <Style x:Key="ValidationErrorsDisplay" TargetType="ItemsControl">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource ValidationErrorTemplate}" />
        </Style>

        <Style x:Key="ValidatedTextBox" TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel>
                            <Border
                                BorderBrush="Red"
                                BorderThickness="2"
                                CornerRadius="2">
                                <AdornedElementPlaceholder />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="Form validation demo (manual InitializeValidation path)" />
            <TextBlock
                Margin="0,4,0,0"
                Opacity="0.7"
                Text="LoginViewModel inherits ViewModelBase, declares fields with DataAnnotations, and calls InitializeValidation(validateOnPropertyChanged: true) in its constructor. Each keystroke re-runs validation; Submit is gated on HasErrors."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Form + status  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Username  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Username *" />
            <TextBox
                x:Name="UsernameTextBox"
                Grid.Row="0"
                Grid.Column="2"
                Style="{StaticResource ValidatedTextBox}"
                Text="{Binding Path=Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />
            <ItemsControl
                Grid.Row="0"
                Grid.Column="4"
                ItemsSource="{Binding ElementName=UsernameTextBox, Path=(Validation.Errors)}"
                Style="{StaticResource ValidationErrorsDisplay}" />

            <!--  Email  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Email *" />
            <TextBox
                x:Name="EmailTextBox"
                Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource ValidatedTextBox}"
                Text="{Binding Path=Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />
            <ItemsControl
                Grid.Row="2"
                Grid.Column="4"
                ItemsSource="{Binding ElementName=EmailTextBox, Path=(Validation.Errors)}"
                Style="{StaticResource ValidationErrorsDisplay}" />

            <!--  Password  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Password *" />
            <TextBox
                x:Name="PasswordTextBox"
                Grid.Row="4"
                Grid.Column="2"
                Style="{StaticResource ValidatedTextBox}"
                Text="{Binding Path=Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" />
            <ItemsControl
                Grid.Row="4"
                Grid.Column="4"
                ItemsSource="{Binding ElementName=PasswordTextBox, Path=(Validation.Errors)}"
                Style="{StaticResource ValidationErrorsDisplay}" />

            <!--  Submit / Reset  -->
            <StackPanel
                Grid.Row="6"
                Grid.Column="2"
                Orientation="Horizontal">
                <Button
                    MinWidth="100"
                    Padding="10,5"
                    Command="{Binding SubmitCommand}"
                    Content="Submit" />
                <Button
                    MinWidth="100"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Command="{Binding ResetCommand}"
                    Content="Reset" />
            </StackPanel>

            <!--  Status  -->
            <Border
                Grid.Row="8"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Padding="10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Has Errors: " />
                        <Run FontWeight="Bold" Text="{Binding Path=HasErrors, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Last submitted username: " />
                        <Run FontWeight="Bold" Text="{Binding Path=LastSubmittedUsername, Mode=OneWay, TargetNullValue='(none yet)'}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>